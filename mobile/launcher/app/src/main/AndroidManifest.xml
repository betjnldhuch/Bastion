<?xml version="1.0" encoding="utf-8"?>
<!-- Версия, minSdk и targetSdk задаются в app/build.gradle (и в build.sh). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/BastionTheme"
        android:allowBackup="true"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustPan|stateHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Сюда добавляется Activity игры (game_activity из assets/launcher.ini),
            когда клиент собирается в этот же APK. Пример:
            <activity
                android:name="com.rockstargames.gtasa.GTASA"
                android:exported="false"
                android:screenOrientation="sensorLandscape"
                android:configChanges="orientation|screenSize|keyboardHidden|keyboard|screenLayout|smallestScreenSize" />
            Пока её нет, кнопка ИГРАТЬ честно сообщает «Игра не найдена».
        -->
    </application>
</manifest>
