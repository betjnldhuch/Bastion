<?xml version="1.0" encoding="utf-8"?>
<!-- Bastion is the single installed Android application; the embedded game
     client is an internal Activity, not a separately installed launcher. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <queries>
        <package android:name="com.rockstargames.gtasa" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/BastionTheme"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false">

        <activity android:name="online.bastion.launcher.InstallerActivity" android:exported="false" />

        <!-- Embedded client screen; no launcher icon or external package. -->
        <activity
            android:name="com.xykal.sampdroid.ui.MainActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="online.bastion.launcher.MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustPan|stateHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
