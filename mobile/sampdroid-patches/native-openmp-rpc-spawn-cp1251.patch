+  logical.reserve(2u + (dataBits + 7u) / 8u);
+  logical.push_back(kLegacyIdRpc);
+  logical.push_back(rpcId);
+  uint32_t remaining = dataBits;
+  while (remaining > 0u) {
+    const int take = remaining >= 8u ? 8 : static_cast<int>(remaining);
+    uint32_t value = 0u;
+    for (int bit = 0; bit < take; ++bit) value = (value << 1) | (reader.readBit() ? 1u : 0u);
+    logical.push_back(static_cast<uint8_t>(value << (8 - take)));
+    remaining -= static_cast<uint32_t>(take);
+  }
+  if (!reader.ok()) return false;
+  packet.payload = std::move(logical);
+  packet.payloadBitLength = static_cast<uint16_t>(16u + dataBits);
+  return true;
