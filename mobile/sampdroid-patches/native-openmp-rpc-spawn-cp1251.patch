+// Bastion: Windows-1251 <-> UTF-8 for SA-MP/open.mp text.
+//
+// SA-MP strings are raw bytes in the server's ANSI codepage; Russian servers
+// (Bastion Online included) use Windows-1251, exactly what the PC client shows.
+// Android/Java needs UTF-8. Inbound text that is already valid UTF-8 with at
+// least one multi-byte sequence is kept; any other high-byte text is decoded
+// as Windows-1251. Outbound text is encoded back to Windows-1251 when every
+// character is representable, so the server receives the same bytes as from a
+// PC client (chat, commands, dialog input such as passwords).
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace samp::legacytext {
+
+inline constexpr uint16_t kCp1251High[128] = {
+    0x0402, 0x0403, 0x201A, 0x0453, 0x201E, 0x2026, 0x2020, 0x2021,
+    0x20AC, 0x2030, 0x0409, 0x2039, 0x040A, 0x040C, 0x040B, 0x040F,
+    0x0452, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014,
+    0xFFFD, 0x2122, 0x0459, 0x203A, 0x045A, 0x045C, 0x045B, 0x045F,
+    0x00A0, 0x040E, 0x045E, 0x0408, 0x00A4, 0x0490, 0x00A6, 0x00A7,
+    0x0401, 0x00A9, 0x0404, 0x00AB, 0x00AC, 0x00AD, 0x00AE, 0x0407,
+    0x00B0, 0x00B1, 0x0406, 0x0456, 0x0491, 0x00B5, 0x00B6, 0x00B7,
+    0x0451, 0x2116, 0x0454, 0x00BB, 0x0458, 0x0405, 0x0455, 0x0457,
+    0x0410, 0x0411, 0x0412, 0x0413, 0x0414, 0x0415, 0x0416, 0x0417,
+    0x0418, 0x0419, 0x041A, 0x041B, 0x041C, 0x041D, 0x041E, 0x041F,
+    0x0420, 0x0421, 0x0422, 0x0423, 0x0424, 0x0425, 0x0426, 0x0427,
+    0x0428, 0x0429, 0x042A, 0x042B, 0x042C, 0x042D, 0x042E, 0x042F,
+    0x0430, 0x0431, 0x0432, 0x0433, 0x0434, 0x0435, 0x0436, 0x0437,
+    0x0438, 0x0439, 0x043A, 0x043B, 0x043C, 0x043D, 0x043E, 0x043F,
+    0x0440, 0x0441, 0x0442, 0x0443, 0x0444, 0x0445, 0x0446, 0x0447,
+    0x0448, 0x0449, 0x044A, 0x044B, 0x044C, 0x044D, 0x044E, 0x044F,
+};
+
+inline void appendUtf8(std::string& out, uint32_t cp) {
+  if (cp < 0x80u) {
+    out.push_back(static_cast<char>(cp));
+  } else if (cp < 0x800u) {
+    out.push_back(static_cast<char>(0xC0u | (cp >> 6)));
+    out.push_back(static_cast<char>(0x80u | (cp & 0x3Fu)));
+  } else {
+    out.push_back(static_cast<char>(0xE0u | (cp >> 12)));
+    out.push_back(static_cast<char>(0x80u | ((cp >> 6) & 0x3Fu)));
+    out.push_back(static_cast<char>(0x80u | (cp & 0x3Fu)));
+  }
+}
+
+// Strict UTF-8 check; `multibyte` reports whether any non-ASCII sequence exists.
+inline bool isStrictUtf8(const std::string& input, bool& multibyte) {
+  multibyte = false;
+  for (size_t i = 0; i < input.size();) {
+    const uint8_t c = static_cast<uint8_t>(input[i]);
+    if (c < 0x80u) { ++i; continue; }
+    size_t width = 0;
+    if (c >= 0xC2u && c <= 0xDFu) width = 2;
+    else if (c >= 0xE0u && c <= 0xEFu) width = 3;
+    else if (c >= 0xF0u && c <= 0xF4u) width = 4;
+    if (width == 0 || i + width > input.size()) return false;
+    for (size_t part = 1; part < width; ++part) {
+      if ((static_cast<uint8_t>(input[i + part]) & 0xC0u) != 0x80u) return false;
+    }
+    const uint8_t n = static_cast<uint8_t>(input[i + 1]);
+    if ((c == 0xE0u && n < 0xA0u) || (c == 0xEDu && n >= 0xA0u) ||
+        (c == 0xF0u && n < 0x90u) || (c == 0xF4u && n >= 0x90u)) {
+      return false;
+    }
+    multibyte = true;
+    i += width;
+  }
+  return true;
+}
+
+// Server bytes -> UTF-8. Never returns invalid UTF-8.
+inline std::string serverTextToUtf8(const std::string& input) {
+  bool multibyte = false;
+  if (isStrictUtf8(input, multibyte)) return input;
+  std::string out;
+  out.reserve(input.size() * 2u);
+  for (const char raw : input) {
+    const uint8_t c = static_cast<uint8_t>(raw);
+    if (c < 0x80u) {
+      out.push_back(raw);
+    } else {
+      const uint16_t cp = kCp1251High[c - 0x80u];
+      if (cp == 0xFFFDu) out.push_back('?'); else appendUtf8(out, cp);
+    }
+  }
+  return out;
+}
+
+// UTF-8 from Android -> Windows-1251 bytes. Returns the input unchanged when it
+// is not valid UTF-8 or contains a character outside Windows-1251.
+inline std::string utf8ToServerText(const std::string& input) {
+  bool multibyte = false;
+  if (!isStrictUtf8(input, multibyte) || !multibyte) return input;
+  std::string out;
+  out.reserve(input.size());
+  for (size_t i = 0; i < input.size();) {
+    const uint8_t c = static_cast<uint8_t>(input[i]);
+    uint32_t cp = c;
+    size_t width = 1;
+    if (c >= 0xF0u) {
+      return input;
+    } else if (c >= 0xE0u) {
+      width = 3;
+      cp = ((c & 0x0Fu) << 12) | ((static_cast<uint8_t>(input[i + 1]) & 0x3Fu) << 6) |
+           (static_cast<uint8_t>(input[i + 2]) & 0x3Fu);
+    } else if (c >= 0xC0u) {
+      width = 2;
+      cp = ((c & 0x1Fu) << 6) | (static_cast<uint8_t>(input[i + 1]) & 0x3Fu);
+    }
+    i += width;
+    if (cp < 0x80u) { out.push_back(static_cast<char>(cp)); continue; }
+    bool found = false;
+    for (unsigned index = 0; index < 128u; ++index) {
+      if (kCp1251High[index] == cp) {
+        out.push_back(static_cast<char>(0x80u + index));
+        found = true;
+        break;
+      }
+    }
+    if (!found) return input;
+  }
+  return out;
+}
+
+// Safety net for the JNI boundary: keeps every valid UTF-8 sequence and turns
+// each remaining high byte into its Windows-1251 character, so a composed JSON
+// string can never hand invalid (Modified) UTF-8 to NewStringUTF. NUL bytes are
+// dropped because NewStringUTF stops at them.
+inline std::string lenientToUtf8(const std::string& input) {
+  bool multibyte = false;
+  bool hasFourByte = false;
+  for (const char raw : input) hasFourByte = hasFourByte || static_cast<uint8_t>(raw) >= 0xF0u;
+  if (!hasFourByte && isStrictUtf8(input, multibyte) && input.find('\0') == std::string::npos) {
+    return input;
+  }
+  std::string out;
+  out.reserve(input.size() + input.size() / 2u);
+  for (size_t i = 0; i < input.size();) {
+    const uint8_t c = static_cast<uint8_t>(input[i]);
+    if (c == 0u) { ++i; continue; }
+    if (c < 0x80u) { out.push_back(static_cast<char>(c)); ++i; continue; }
+    size_t width = 0;
+    if (c >= 0xC2u && c <= 0xDFu) width = 2;
+    else if (c >= 0xE0u && c <= 0xEFu) width = 3;
+    else if (c >= 0xF0u && c <= 0xF4u) width = 4;
+    if (width != 0 && i + width <= input.size()) {
+      const std::string piece = input.substr(i, width);
+      bool pieceMultibyte = false;
+      if (isStrictUtf8(piece, pieceMultibyte)) {
+        // Modified UTF-8 has no 4-byte form (it needs surrogate pairs).
+        if (width == 4) out.push_back('?'); else out += piece;
+        i += width;
+        continue;
+      }
+    }
+    const uint16_t cp = kCp1251High[c - 0x80u];
+    if (cp == 0xFFFDu) out.push_back('?'); else appendUtf8(out, cp);
+    ++i;
+  }
+  return out;
+}
+
+}  // namespace samp::legacytext
