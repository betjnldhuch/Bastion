+  BitReader reader(packet.payload.data(), packet.payload.size(), declaredBits);
+  reader.readBits(8);
+  const uint8_t rpcId = static_cast<uint8_t>(reader.readBits(8));
+  const uint32_t dataBits = reader.readCompressedU32();
+  if (!reader.ok() || dataBits > declaredBits - reader.bitPosition()) return false;
