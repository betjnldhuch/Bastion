+// Bastion: Russian servers send Windows-1251; Android must show and send it.
+void testBastionLegacyTextAndForcedSpawn() {
+  const std::string cp1251Login("\xC2\xF5\xEE\xE4", 4);  // "Вход"
+  expect(samp::legacytext::serverTextToUtf8(cp1251Login) == "\xD0\x92\xD1\x85\xD0\xBE\xD0\xB4",
+         "Windows-1251 server text must become UTF-8");
+  expect(samp::legacytext::serverTextToUtf8("\xD0\x92\xD1\x85\xD0\xBE\xD0\xB4") ==
+             "\xD0\x92\xD1\x85\xD0\xBE\xD0\xB4",
+         "valid UTF-8 server text must stay unchanged");
+  expect(samp::legacytext::utf8ToServerText("\xD0\x92\xD1\x85\xD0\xBE\xD0\xB4 ok") ==
+             std::string("\xC2\xF5\xEE\xE4 ok", 7),
+         "UTF-8 Android input must be sent as Windows-1251");
+  expect(samp::legacytext::utf8ToServerText("plain") == "plain", "ASCII must stay unchanged");
+  expect(samp::legacytext::lenientToUtf8(std::string("ok \xD0\x92 \xC2", 7)) == "ok \xD0\x92 \xD0\x92" &&
+             samp::legacytext::lenientToUtf8("\xF0\x9F\x98\x80") == "?",
+         "JNI safety net must keep UTF-8, decode stray Windows-1251 and drop 4-byte forms");
+  samp::state::WorldState chatWorld;
+  samp::state::RpcEvent chatEvent;
+  std::vector<uint8_t> chat = {20u, 93u, 0xFFu, 0xFFu, 0xFFu, 0xFFu, 4u, 0u, 0u, 0u, 0xC2u, 0xF5u, 0xEEu, 0xE4u};
+  expect(chatWorld.applyRpc(chat, chatEvent) && !chatWorld.recentChat(4).empty() &&
+             chatWorld.recentChat(4).back().text == "\xD0\x92\xD1\x85\xD0\xBE\xD0\xB4",
+         "Windows-1251 SendClientMessage must reach the HUD as UTF-8");
+  const auto dialog = samp::clientrpc::buildDialogResponse(1, true, -1, "\xD0\xBF\xD0\xB0\xD1\x80\xD0\xBE\xD0\xBB\xD1\x8C");
+  expect(dialog.size() == 2u + 2u + 1u + 2u + 1u + 6u && dialog[7] == 6u &&
+             static_cast<uint8_t>(dialog[8]) == 0xEFu,
+         "dialog response must carry Windows-1251 bytes");
+
+  samp::state::WorldState world;
+  samp::state::RpcEvent event;
+  expect(world.applyRpc(makePlayerInit(), event), "forced-spawn PlayerInit rejected");
+  const std::vector<uint8_t> spectateOn = {20u, 124u, 1u, 0u, 0u, 0u};
+  const std::vector<uint8_t> spectateOff = {20u, 124u, 0u, 0u, 0u, 0u};
+  expect(world.applyRpc(spectateOn, event) && !event.serverForcedSpawn && !world.spawnAllowed(),
+         "entering spectate must not grant spawn");
+  expect(world.applyRpc(spectateOff, event) && event.serverForcedSpawn && world.spawnAllowed(),
+         "TogglePlayerSpectating(false) after spectating must grant a server spawn");
+  samp::state::WorldState fresh;
+  expect(fresh.applyRpc(makePlayerInit(), event), "immediate-spawn PlayerInit rejected");
+  expect(fresh.applyRpc(makeEmptyRpc(129u), event) && event.serverForcedSpawn &&
+             event.kind == samp::state::RpcEventKind::SpawnResponse && fresh.spawnAllowed(),
+         "bodyless RPC 129 (ImmediatelySpawnPlayer) must grant a server spawn");
+}
